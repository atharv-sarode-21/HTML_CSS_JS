<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <style>
    button {
  height: 50px;
  width: 110px;
  margin-top: 4px;
  margin: 6px;
  border-radius: 19px;
}

#red {
  color: aliceblue;
  background-color: red;
}

#yellow {
  background-color: yellow;
}

#green {
  background-color: green;
  color: aliceblue;
}

#blue {
  background-color: blue;
  color: aliceblue;
}

#black {
  background-color: black;
  color: aliceblue;
}

#grid {
  display: flex;
}

.next {
  height: 500px;
  width: 250;
  background-color: aqua;
  display: flex;
  justify-content: center;
  align-items: center;
}

.a1 {
  height: 250px;
  width: 200px;
  background-color: black;
  margin: 10px;
}

.a2 {
  height: 250px;
  width: 200px;
  background-color: green;
  margin: 10px;
}

.a3 {
  height: 250px;
  width: 200px;
  background-color: chartreuse;
  margin: 10px;
}

.a4 {
  height: 250px;
  width: 200px;
  background-color: red;
  margin: 10px;
}

.a5 {
  height: 250px;
  width: 200px;
  background-color: yellow;
  margin: 10px;
}

.a6 {
